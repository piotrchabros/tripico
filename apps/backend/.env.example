# Tripico backend env vars
# Copy to .env and fill with real values. Never commit .env.

# Postgres connection string (Neon in prod, local Docker in dev)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# JWT RS256 keypair (PRD §12). Generate per dev machine:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
# Paste PEM contents verbatim between the quotes (multi-line is supported).
# Production: paste production keys into Railway env vars.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...PASTE PRIVATE PEM...
-----END PRIVATE KEY-----
"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...PASTE PUBLIC PEM...
-----END PUBLIC KEY-----
"
