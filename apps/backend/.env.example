# Tripico backend env vars
# Copy to .env and fill with real values. Never commit .env.

# Postgres connection string (Neon in prod, local Docker in dev)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# JWT RS256 keypair (PRD §12). Generate per dev machine:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
# Paste PEM contents verbatim between the quotes (multi-line is supported).
# Production: paste production keys into Railway env vars.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...PASTE PRIVATE PEM...
-----END PRIVATE KEY-----
"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...PASTE PUBLIC PEM...
-----END PUBLIC KEY-----
"

# Comma-separated allowed CORS origins for cross-origin auth flows (set on
# Railway in prod with the production Vercel URL). Local default if unset:
# http://localhost:4200.
# CORS_ALLOWED_ORIGINS="https://tripico-alpha.vercel.app"

# Set to `true` only on dev/staging to surface the email verification +
# password reset tokens in the API response body for manual testing
# without an email provider. ADR-007 — keep OFF in production.
# EMAIL_DEV_TOKENS="false"

# PostHog (Cloud EU). Same project API key as the frontend bundle.
# Leave unset to disable server-side analytics (capture becomes a no-op).
# POSTHOG_API_KEY="phc_..."
# POSTHOG_HOST="https://eu.i.posthog.com"
