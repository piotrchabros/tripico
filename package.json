{
  "name": "@tripico/source",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@9.9.4",
  "overrides": {
    "@noble/hashes": "1.8.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-npm-version.mjs",
    "verify:lockfile": "SKIP_NPM_VERSION_CHECK=1 npm ci --dry-run --include=dev --no-audit --no-fund",
    "prisma:generate": "cd apps/backend && prisma generate",
    "prisma:migrate": "cd apps/backend && prisma migrate dev",
    "prisma:deploy": "cd apps/backend && prisma migrate deploy",
    "prisma:studio": "cd apps/backend && prisma studio",
    "backend:start": "node dist/apps/backend/main.js",
    "backend:release": "npm run prisma:deploy && npm run prisma:generate",
    "build:backend": "nx build backend --skip-nx-cache",
    "build:frontend": "node scripts/inject-build-env.mjs && nx build tripico --skip-nx-cache"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/platform-server": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@angular/ssr": "~21.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.20",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.20",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "pg": "^8.20.0",
    "posthog-js": "^1.373.4",
    "posthog-node": "^5.34.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.2.0",
